# Server
HOST=0.0.0.0
PORT=8002
DEBUG=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=meeting_minutes

# LLM APIs
OLLAMA_API=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:4b

VLLM_API=http://localhost:8000/v1/chat/completions
VLLM_MODEL=/path/to/model

PRODUCTION_IP=10.6.2.178

# ASR Models
ASR_MODEL=iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
PUNC_MODEL=iic/punc_ct-transformer_cn-en-common-vocab471067-large
SPK_MODEL=iic/speech_campplus_sv_zh-cn_16k-common
DEVICE=cuda:0

# Model Cache
MODELSCOPE_CACHE=/home/user/.cache/modelscope
